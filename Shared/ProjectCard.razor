@using AppBuilder.Models
@inject NavigationManager Nav

<MudPaper Outlined="true" Class="rounded-lg">
    <MudImage Src="@Item.CoverImage" ObjectFit="ObjectFit.Cover" Class="mask-image rounded-lg" Alt="@Item.Title" />

    <MudStack Class="pa-4 pa-md-8" Spacing="1">
    <MudText Typo="Typo.h6" Color="Color.Default">@Item.Title</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">@Item.Summary</MudText>

        <MudStack Row="true"
                  Spacing="1"
                  Class="mt-2"
                  Wrap="Wrap.Wrap">
      @foreach (var t in Item.Tags.Take(4))
      {
                <MudChip T="string"
                         Label="true"
                         Size="Size.Small"
                         Variant="Variant.Text"
                         Color="Color.Success">
                    @t
                </MudChip>
      }
    </MudStack>
        <MudDivider Class="my-1" />
    <MudStack Justify="Justify.SpaceBetween" Row="true" Spacing="2" Class="mt-3">
      @if (!string.IsNullOrWhiteSpace(Item.LiveUrl))
      {
                <MudButton Variant="Variant.Text" Size="Size.Small" Href="@Item.LiveUrl" StartIcon="@Icons.Custom.Brands.GitHub" Color="Color.Default" Target="_blank"><MudText Typo="Typo.caption">Github</MudText></MudButton>
      }
            <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Outlined.ArrowForward" Color="Color.Success" Size="Size.Small"
                 OnClick="@(() => Nav.NavigateTo($"/projects/{Item.Slug}"))">
                <MudText Typo="Typo.caption">Leer Informe</MudText>
      </MudButton>
    </MudStack>
  </MudStack>
</MudPaper>

@code {
  [Parameter, EditorRequired] public ProjectItem Item { get; set; } = default!;
}