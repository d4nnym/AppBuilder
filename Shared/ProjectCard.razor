@using AppBuilder.Models
@inject NavigationManager Nav

<MudPaper Outlined="true" Class="card">
  <MudImage Src="@Item.CoverImage" Height="180" ObjectFit="ObjectFit.Cover" />

  <MudStack Class="p-4" Spacing="1">
    <MudText Typo="Typo.h6">@Item.Title</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">@Item.Summary</MudText>

        <MudStack Row="true"
                  Spacing="1"
                  Class="mt-2"
                  Wrap="Wrap.Wrap">
      @foreach (var t in Item.Tags.Take(4))
      {
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Filled"
                         Color="Color.Success">
                    @t
                </MudChip>
      }
    </MudStack>

    <MudStack Row="true" Spacing="2" Class="mt-3">
      @if (!string.IsNullOrWhiteSpace(Item.LiveUrl))
      {
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="@Item.LiveUrl" Target="_blank">Sitio</MudButton>
      }
            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small"
                 OnClick="@(() => Nav.NavigateTo($"/projects/{Item.Slug}"))">
        Ver más
      </MudButton>
    </MudStack>
  </MudStack>
</MudPaper>

@code {
  [Parameter, EditorRequired] public ProjectItem Item { get; set; } = default!;
}