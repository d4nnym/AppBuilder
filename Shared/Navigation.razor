@implements IDisposable
@inject NavigationManager NavManager
@inject AppBuilder.Services.ThemeService Theme

<MudButton StartIcon="@Icon"
           OnClick="Navigate"
           DisableElevation="true"
           Size="Size.Medium"
           Variant="@GetVariant()"
           Color="@GetColor()">
    <MudText>@Text</MudText>
</MudButton>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = default!;
    [Parameter, EditorRequired] public string Href { get; set; } = default!;
    [Parameter] public string Icon { get; set; } = Icons.Material.Outlined.Circle;
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
        Theme.Changed += OnThemeChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void OnThemeChanged()
        => InvokeAsync(StateHasChanged);

    private void Navigate()
        => NavManager.NavigateTo(Href);

    private bool IsActive()
    {
        string Normalize(string path)
        {
            path = path.Trim('/');

            return string.IsNullOrWhiteSpace(path)
                ? "/#"
                : path;
        }

        var current = Normalize(NavManager.ToBaseRelativePath(NavManager.Uri));
        var target = Normalize(Href);

        return Match switch
        {
            NavLinkMatch.All => string.Equals(current, target, StringComparison.OrdinalIgnoreCase),
            _ => current.StartsWith(target, StringComparison.OrdinalIgnoreCase)
        };
    }

    private Variant GetVariant()
    {
        var active = IsActive();

        if (!Theme.IsDark && !active) return Variant.Text;
        if (Theme.IsDark && !active) return Variant.Text;
        return Variant.Filled;
    }

    private Color GetColor()
    {
        var active = IsActive();

        if (active) return Color.Success;

        if (Theme.IsDark) return Color.Primary;

        return Color.Success;
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        Theme.Changed -= OnThemeChanged;
    }
}