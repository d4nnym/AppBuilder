@using AppBuilder.Shared
<nav>
    <MudStack Row="@(!IsVertical)" Spacing=" 1" Class="p-0 w-100" AlignItems="AlignItems.Stretch" Wrap="Wrap.Wrap">
        <Navigation Text="Inicio" Href="/" Icon="@Icons.Material.Outlined.Home" Match="NavLinkMatch.All" />
        <Navigation Text="Proyectos" Href="/projects" Icon="@Icons.Material.Filled.Code" />
        <Navigation Text="Recursos" Href="/resources" Icon="@Icons.Material.Outlined.RemoveRedEye" />
        <Navigation Text="Sobre mi" Href="/aboutme" Icon="@Icons.Material.Outlined.Info" />
    </MudStack>
</nav>

@code {
    [Parameter] public bool IsVertical { get; set; } = false;
    [Parameter] public EventCallback OnNavigate { get; set; }

    [Inject] NavigationManager Nav { get; set; } = default!;

    private async Task Go(string url)
    {
        Nav.NavigateTo(url);
        if (OnNavigate.HasDelegate)
            await OnNavigate.InvokeAsync();
    }
}