@using AppBuilder.Theme
@inject AppBuilder.Services.ThemeService Theme
@inherits LayoutComponentBase

<MudThemeProvider Theme="@CurrentTheme" IsDarkMode="@Theme.IsDark" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
<MudGrid>
    <MudItem xs="12">
        <header>
            <MudAppBar Color="Color.Surface" Elevation="4">
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                   Color="Color.Inherit"
                                   OnClick="@(()=>_drawerOpen = true)" />
                </MudHidden>
                <MudText Typo="Typo.h6">AppBuilder</MudText>
                <MudSpacer />
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <NavMenu />
                </MudHidden>

                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Brightness4" Color="Color.Primary" OnClick="@ToggleTheme" />
            </MudAppBar>

            <MudDrawer Open="@_drawerOpen"
                       OpenChanged="@(v => _drawerOpen = v)"
                       Anchor="Anchor.Left"
                       Variant="DrawerVariant.Temporary"
                       Elevation="8"
                       Style="background-color: var(--mud-palette-drawer-background);">
                <MudStack Style="background-color: var(--mud-palette-drawer-background);" Spacing="2" Class="pa-4">
                    <MudText Typo="Typo.h6">Menú</MudText>
                    <NavMenu IsVertical="true" OnNavigate="CloseDrawer" />
                </MudStack>
            </MudDrawer>
        </header>

    </MudItem>
    <MudItem xs="12">
        <main>
            <MudLayout>
                <MudMainContent>
                    @Body
                </MudMainContent>
            </MudLayout>
        </main>
    </MudItem>

</MudGrid>

@code {
    private MudTheme CurrentTheme => Theme.IsDark ? AppTheme.Dark : AppTheme.Light;
    private bool _drawerOpen;
    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += StateHasChanged;
        await Theme.InitializeAsync();
    }

    private async Task ToggleTheme() => await Theme.ToggleAsync();

    public void Dispose()
    {
        Theme.Changed -= StateHasChanged;
    }

    private Task CloseDrawer()
    {
        _drawerOpen = false;
        return Task.CompletedTask;
    }
}